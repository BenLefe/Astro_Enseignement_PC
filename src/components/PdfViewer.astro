---
interface Props {
  src: string;
  height?: string;
  page?: number;
}

const { src, height = "600px", page = 1 } = Astro.props;

// Pure web production path formatting
const cleanSrc = src.replace('/Astro_Enseignement_PC', '');
const fullSrc = cleanSrc.startsWith('/') ? cleanSrc : `/${cleanSrc}`;

// Native page parameter mapping for the live site
const nativeViewerUrl = `${fullSrc}#page=${page}`;
---

<div class="pdf-viewer-wrapper" style="margin: 2rem 0; width: 100%;">
  <iframe 
    src={nativeViewerUrl} 
    width="100%" 
    height={height} 
    style="border: 2px solid var(--sl-color-gray-5); border-radius: 8px; box-shadow: var(--sl-shadow-sm); background: #ffffff;"
    allowfullscreen
  />
  
  <p style="margin-top: 0.6rem; font-family: 'Comic Neue', sans-serif; font-size: 0.85rem; text-align: right;">
    📄 Si le document ne s'affiche pas : 
    <a href={fullSrc} target="_blank" rel="noopener noreferrer" style="color: #143fbe; font-weight: bold; text-decoration: underline;">
      Cliquez ici pour l'ouvrir directement
    </a>.
  </p>
</div>
